{
  "name": "nepalipatrojs",
  "version": "2.0.0",
  "description": "A JavaScript library for Nepali date conversion and calendar utilities",
  "type": "module",
  "main": "./dist/nepali-patro-js.cjs",
  "module": "./dist/nepali-patro-js.esm.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/palhimalaya/nepalipatrojs"
  },
  "files": [
    "dist/nepali-patro-js.cjs",
    "dist/nepali-patro-js.cjs.map",
    "dist/nepali-patro-js.esm.js",
    "dist/nepali-patro-js.esm.js.map",
    "dist/nepali-patro-js.umd.js",
    "dist/nepali-patro-js.umd.js.map",
    "dist/nepali-patro-js.css",
    "dist/index.d.ts",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nepali-patro-js.esm.js",
      "require": "./dist/nepali-patro-js.cjs"
    },
    "./css": "./dist/nepali-patro-js.css",
    "./styles": "./dist/nepali-patro-js.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "./dist/nepali-patro-js.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && rollup -c",
    "dev": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "prepublishOnly": "npm run build && npm test && npm run pack:smoke"
  },
  "keywords": [
    "nepali",
    "nepalipatrojs",
    "nepali-patro",
    "nepali-calendar",
    "nepali-date",
    "nepali-date-picker",
    "nepali-datepicker",
    "nepali-calendar-js",
    "calendar",
    "date",
    "patro",
    "bs",
    "ad",
    "conversion"
  ],
  "author": "Himalaya Pal",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.17",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.5",
    "rollup": "^4.46.1",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-postcss": "^4.0.2",
    "ts-jest": "^29.3.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
